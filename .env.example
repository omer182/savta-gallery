# Copy to .env.local for development. In production these are set in
# Portainer's Environment variables panel, never in the compose YAML (PLAN.md §7).

# Where all persistent state lives: db/, images/, audio/.
# The container mounts /data; locally this defaults to ./data if unset.
DATA_DIR=./data

# Signs the session cookie. Generate with:  openssl rand -hex 32
SESSION_SECRET=

# argon2id hashes — the password itself determines the role (PLAN.md §3).
# Generate with:  npm run hash
ADMIN_PASSWORD_HASH=
ARTIST_PASSWORD_HASH=
